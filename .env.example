# ==============================================================================
# Telegram Bot Configuration (REQUIRED)
# ==============================================================================
# Obtain your Bot Token from @BotFather on Telegram
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# ==============================================================================
# Server Configuration (Render automatically sets PORT)
# ==============================================================================
PORT=8080

# ==============================================================================
# Database Configuration - MongoDB Atlas (OPTIONAL BUT STRONGLY RECOMMENDED)
# ==============================================================================
# MongoDB Atlas Connection URI (Format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/biolink_bot?retryWrites=true&w=majority)
# If left blank, the bot safely falls back to local in-memory/JSON storage.
MONGO_URI=mongodb+srv://db_username:db_password@cluster0.abcde.mongodb.net/biolink_bot?retryWrites=true&w=majority

